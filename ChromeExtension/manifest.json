{
    "manifest_version": 3,

    "name": "Geniuslink | Intelligent Link Creator",
    "description": "Easily build geni.us links with the click of a button!",
    "version": "1.0.5",

    "action": {
        "default_icon": "images/icon.png",
        "default_popup": "apikeys.html"
    },
    "icons": {
        "16": "images/icon.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "content_scripts": [{
        "matches": ["http://*/*", "https://*/*", "*://*/*"],
        "js": ["js/openDialog.js"]
    }],
    "web_accessible_resources": [
        {
            "resources": [
                "css/custom.css",
                "js/frame.js",
                "alertDoneInside.html", "alertLoadingInside.html", "alertDoneOutside.html", "alertLoadingOutside.html", "css/vsprites.svg", "css/main.css", "js/bootstrap.min.js"        
            ],
            "matches": [
              "*://*/*"
            ]
        }
    ],

    "background": {
        "service_worker": "loader.js"
    },

    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },

    "permissions": [
        "activeTab",
        "contextMenus",
        "storage",
        "clipboardRead",
        "tabs"
    ],

    "host_permissions": [
        "https://ajax.googleapis.com/",
        "https://api.geni.us/",
        "http://*/*", "https://*/*"
    ]
}